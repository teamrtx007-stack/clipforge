# Copy this file to .env and fill in only what you use. .env is ignored by Git: never commit keys.
# Every AI provider here is optional and free-tier. With nothing set, ClipForge runs fully locally.

# --- Recommended: the ClipForge AI gateway on Supabase (docs/AI_GATEWAY.md) ---
# Provider keys then live only in Supabase secrets; this machine holds just the gateway token.
GATEWAY_URL=
GATEWAY_TOKEN=

# --- Or call providers directly with keys on this machine (tried in this order; empty = not used) ---
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Cloudflare Workers AI: account ID from the dashboard, and an API token with "Workers AI" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# OpenRouter key: https://openrouter.ai/keys (free models only; 50 requests a day without credit)
OPENROUTER_API_KEY=
# Optional: choose and order text providers, e.g. groq,gemini. Default: every one with a key above.
TEXT_PROVIDERS=
# Optional model overrides (defaults: gemini-3.8-flash, openai/gpt-oss-120b,
# @cf/meta/llama-3.3-70b-instruct-fp8-fast, openrouter/free)
GEMINI_MODEL=
GROQ_MODEL=
CLOUDFLARE_MODEL=
OPENROUTER_MODEL=

# --- Speech to text ---
# Order to try, per 10-minute chunk: local, gateway, groq, cloudflare. Default: local only. With the gateway: gateway,local
# Cloud speech uploads the audio to that provider. Example for a PC without a GPU: groq,cloudflare,local
TRANSCRIBE_PROVIDERS=
# Force the spoken language, e.g. hi for Hindi (stops Hindi coming out in Urdu script). Empty = detect.
TRANSCRIBE_LANGUAGE=
# Local model: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Keep each clip inside one scene (no jump from outdoors to indoors). 0 = the old choice, from speech and sound only
SCENE_DETECTION=1

# --- Cloud storage (docs/STORAGE.md). Empty = files stay on this computer ---
# Cloudflare R2: primary storage and download location
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
# Backblaze B2: verified backups of finished clips
B2_ENDPOINT_URL=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=
B2_REGION=
# Retention with cloud storage; a last copy is never deleted
SOURCE_KEEP_HOURS=24
CLIP_KEEP_DAYS=7
BACKUP_KEEP_DAYS=30
# Refuse uploads past each provider's free 10 GB instead of paying (1 = on)
STORAGE_STOP_AT_LIMIT=1

# --- Storage on this computer (when no cloud storage is set) ---
# Hours before videos and their clips are deleted. 0 keeps everything.
KEEP_HOURS=24
